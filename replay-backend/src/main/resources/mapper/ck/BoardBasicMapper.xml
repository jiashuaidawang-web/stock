<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dunwugudao.replay.mapper.ck.BoardBasicMapper">

    <select id="selectByBoardType" resultType="com.dunwugudao.replay.entity.ck.raw.BoardBasic">
        SELECT board_type, code, board_code, board_name, features, status
        FROM board_basic
        WHERE board_type = #{boardType}
    </select>

</mapper>
