<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dunwugudao.replay.mapper.ck.LimitDownPoolMapper">

    <select id="selectByTradeDate" resultType="com.dunwugudao.replay.entity.ck.raw.LimitDownPool">
        SELECT trade_date, ts_code, stock_name, pct_chg, pe, fba, days, oc, amount, ltsz
        FROM limit_down_pool
        WHERE trade_date = #{tradeDate}
    </select>

</mapper>
