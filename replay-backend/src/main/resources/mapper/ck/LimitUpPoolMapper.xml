<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dunwugudao.replay.mapper.ck.LimitUpPoolMapper">

    <select id="selectByTradeDate" resultType="com.dunwugudao.replay.entity.ck.raw.LimitUpPool">
        SELECT trade_date, ts_code, stock_name, latest_price, pct_chg,
               board_pos, limit_style, turnover_rate, board_code, ltsz, amount
        FROM limit_up_pool
        WHERE trade_date = #{tradeDate}
    </select>

    <select id="selectMaxTradeDate" resultType="java.time.LocalDate">
        SELECT max(trade_date) FROM limit_up_pool
    </select>

</mapper>
