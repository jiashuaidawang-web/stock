# 模板：复制为 .env 后按目标环境填写
# HOST_IP：Docker 主机在容器可达的地址。Windows Docker Desktop 用 host.docker.internal
#          指向宿主机（用于 crawler 间 / xxl-job 控制面地址）。
HOST_IP=host.docker.internal

# ClickHouse（分析型库，已预装在宿主机 / DMZ，由下面 HOST:PORT 接入，compose 不再起容器）
# 用户实测 dbeaver 经此连接可达；若容器内访问不到该 LAN IP，把 CK_HOST 改为 host.docker.internal。
CK_HOST=100.97.74.45
CK_PORT=8123
CK_DB=crawler           # 新环境（Windows）也用 crawler（与旧环境一致；wushi 已存在不占用）
CK_USER=default
CK_PASSWORD=pamirs@123

# openGauss（操作型库：worker 拉任务 / seed 写库 / replay 任务表）
# ★ 已预装在宿主机 / DMZ，不通过 compose 起容器。填你那台机器上 OG 的实际连接。
#   OG_HOST：与 CK 同机，直接用宿主 LAN IP（或 host.docker.internal）。
#   OG_PORT：你给的是 5432（容器内端口，非 15432）。
OG_HOST=100.97.74.45
OG_PORT=5432
OG_DB=postgres
OG_USER=dbuser
OG_PASSWORD=OpenGauss@2026
